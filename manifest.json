{
  "manifest_version": 3,
  "name": "SME Website Consultant",
  "version": "1.0",
  "description": "Instant, offline website audit for small business owners.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "Analyze Page"
  },
  "icons": {
    "16": "src/icons/icon16.png",
    "48": "src/icons/icon48.png",
    "128": "src/icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["src/styles.css"],
      "matches": ["<all_urls>"]
    }
  ]
}
